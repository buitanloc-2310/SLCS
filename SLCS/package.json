{
  "name": "sfn-slc",
  "version": "40.0.0-p2-production",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name slc",
    "db:migrate": "wrangler d1 migrations apply skyfirsthoctap --remote",
    "db:migrate:local": "wrangler d1 migrations apply skyfirsthoctap --local",
    "check": "node --check src/index.js && node --check src/schema-v11.js && node --check src/live-room.js && node --check src/realtime-sfu.js && node --check src/v13-platform.js && node --check src/vplus-platform.js && node --check public/app.js && node --check public/classroom/media-client.js && node --check public/classroom/classroom-plus.js && node --check functions/api/[[path]].js",
    "validate:vplus": "npm run check && node scripts/validate-vplus.mjs",
    "deploy:p0": "npm run check && npm run deploy",
    "validate:p0": "npm run validate:vplus && node scripts/validate-p0.mjs",
    "validate:config": "node scripts/validate-config.mjs",
    "validate:p2": "npm run validate:p0 && npm run validate:config && node scripts/validate-p2.mjs",
    "validate:p11": "npm run validate:p0 && node scripts/validate-p11.mjs",
    "validate:p21": "npm run validate:p11 && node scripts/validate-p21.mjs",
    "validate:p22": "npm run validate:p21 && node scripts/validate-p22.mjs",
    "validate:p23": "npm run validate:p22 && node scripts/validate-p23.mjs",
    "validate:p24": "npm run validate:p23 && npm run validate:p2 && node scripts/validate-p24.mjs",
    "validate:final": "npm run validate:p24 && node scripts/validate-final.mjs",
    "validate:release": "npm run validate:final && node scripts/validate-v33-release.mjs",
    "validate:v34": "npm run validate:release && node scripts/validate-v34.mjs",
    "validate:v35": "npm run validate:v34 && node scripts/validate-v35.mjs",
    "validate:v36": "npm run validate:v35 && node scripts/validate-v36.mjs",
    "validate:v37": "npm run validate:v36 && node scripts/validate-v37.mjs",
    "validate:v38": "npm run validate:v37 && node scripts/validate-v38.mjs",
    "validate:v39": "npm run validate:v38 && node scripts/validate-v39.mjs",
    "validate:v40": "npm run validate:v39 && node scripts/validate-v40.mjs",
    "validate:production": "npm run validate:v40"
  },
  "devDependencies": {
    "wrangler": "4.34.0"
  }
}
