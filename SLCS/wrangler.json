{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slcs",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_URL": "https://slc.skyfirst.io.vn",
    "SUPPORT_EMAIL": "support@skyfirst.io.vn",
    "APP_NAME": "Trung tâm Học tập Số Sky First Network",
    "SESSION_DAYS": "30",
    "MAIL_FROM": "Trung tâm Học tập Số Sky First Network <slc@skyfirst.io.vn>",
    "REALTIME_APP_NAME": "skyfirsthoc",
    "REALTIME_API_BASE": "https://rtc.live.cloudflare.com/v1",
    "AI_PRODUCT_NAME": "Sky First Network AI",
    "AI_PROVIDER": "openai_responses",
    "AI_API_URL": "https://api.openai.com/v1/responses",
    "AI_MODEL": "gpt-5.6-luna",
    "AI_TIMEOUT_MS": "30000",
    "AI_ENABLE_WEB_SEARCH": "1",
    "BOOTSTRAP_ENABLED": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sfn-slc-db",
      "database_id": "6fd6a6c3-aae6-4b11-89e0-8e13a0e27d3c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "skyfirsthoctap"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_ROOM",
        "class_name": "LiveRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LiveRoom"
      ]
    }
  ]
}
